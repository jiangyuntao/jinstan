{extends '../layouts/default.jst'}
{block content}
<section class="listing-shell">
    <header class="listing-head"><h1>{$type->label}</h1></header>
    <div class="board-list">
        {foreach $items as $item}
        <article class="board-row"><div><h2><a href="{$item['url']}">{$item['title']}</a></h2>{if $item['excerpt']}<p>{$item['excerpt']}</p>{/if}</div><span class="row-arrow" aria-hidden="true">↗</span></article>
        {else}<p class="empty-state">暂时没有已发布的内容。</p>{/foreach}
    </div>
    {include '../partials/list-pagination.jst'}
</section>
{/block}
