<style n:syntax="off">
:root{color-scheme:light;--bg:#f2f4f6;--card:#fff;--text:#191f28;--muted:#6b7684;--blue:#3182f6;--blue-hover:#2272eb;--blue-soft:#e8f3ff;--border:#e5e8eb;--shadow:0 1px 2px rgba(2,32,71,.04),0 8px 24px rgba(2,32,71,.035);--sans:Pretendard,Inter,"Noto Sans SC","PingFang SC","Microsoft YaHei",ui-sans-serif,system-ui,sans-serif;--mono:"SFMono-Regular",Consolas,monospace}
.theme-site{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}.theme-site *{box-sizing:border-box}.theme-site a{color:inherit;text-decoration:none}.theme-site img{max-width:100%}.theme-site :focus-visible{outline:3px solid rgba(49,130,246,.24);outline-offset:2px}.site-width{width:min(1180px,calc(100% - 48px));margin-inline:auto}.skip-link{position:fixed;top:-80px;left:24px;z-index:100;padding:10px 16px;border-radius:8px;background:var(--text);color:#fff;font-size:14px}.skip-link:focus{top:16px}
.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(229,232,235,.9);background:rgba(255,255,255,.92);backdrop-filter:blur(14px)}.header-inner{display:flex;min-height:68px;align-items:center;justify-content:space-between;gap:36px}.brand{display:inline-flex;align-items:center;gap:10px;font-size:18px;font-weight:800;letter-spacing:-.035em}.brand-mark{width:22px;height:22px;border:6px solid var(--blue);border-radius:7px;transform:rotate(45deg)}.header-nav{display:flex;align-items:center;gap:28px}.primary-menu{display:flex;align-items:center;gap:6px;margin:0;padding:0;list-style:none}.primary-menu li{position:relative}.primary-menu a{display:block;padding:9px 12px;border-radius:8px;color:#4e5968;font-size:14px;font-weight:600;transition:.15s ease}.primary-menu a:hover{background:var(--blue-soft);color:var(--blue)}.primary-menu li>ul{display:none;position:absolute;top:calc(100% + 8px);left:0;min-width:190px;margin:0;padding:7px;border:1px solid var(--border);border-radius:12px;background:var(--card);box-shadow:0 12px 32px rgba(2,32,71,.12);list-style:none}.primary-menu li:hover>ul,.primary-menu li:focus-within>ul{display:block}.primary-menu li>ul li>ul{top:-8px;left:calc(100% + 8px)}.primary-menu li>ul a{white-space:nowrap}.nav-toggle{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.menu-toggle{display:none;border:0;border-radius:8px;padding:8px 10px;background:var(--blue-soft);color:var(--blue);cursor:pointer;font:600 13px var(--sans)}.site-main{min-height:70vh;padding-block:36px 80px}
.hero{position:relative;overflow:hidden;padding:clamp(44px,7vw,82px);border:1px solid var(--border);border-radius:24px;background:linear-gradient(125deg,#fff 0%,#f8fbff 54%,#e9f3ff 100%);box-shadow:var(--shadow)}.hero:after{position:absolute;right:-120px;bottom:-230px;width:430px;height:430px;border:70px solid rgba(49,130,246,.07);border-radius:50%;content:""}.hero-copy{position:relative;z-index:1;max-width:760px}.eyebrow,.listing-kicker{display:inline-flex;align-items:center;gap:8px;margin:0 0 20px;padding:6px 10px;border-radius:999px;background:var(--blue-soft);color:var(--blue);font-size:12px;font-weight:700}.eyebrow:before{width:6px;height:6px;border-radius:50%;background:var(--blue);content:""}.hero h1{max-width:780px;margin:0;font-size:clamp(40px,6.5vw,72px);font-weight:800;line-height:1.12;letter-spacing:-.06em;overflow-wrap:anywhere}.hero-description{max-width:650px;margin:24px 0 0;color:var(--muted);font-size:18px;line-height:1.75}.hero-links{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}.hero-links a,.section-title a{display:inline-flex;align-items:center;min-height:40px;padding:0 15px;border:1px solid var(--border);border-radius:10px;background:#fff;color:#4e5968;font-size:13px;font-weight:600;transition:.15s ease}.hero-links a:first-child{border-color:var(--blue);background:var(--blue);color:#fff}.hero-links a:hover,.section-title a:hover{border-color:#b8d5ff;background:var(--blue-soft);color:var(--blue);transform:translateY(-1px)}
.home-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:24px}.home-section{min-width:0;padding:26px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}.section-title{display:flex;align-items:center;justify-content:space-between;gap:18px}.section-title h2,.section-title h1{margin:0;font-size:21px;font-weight:750;line-height:1.35;letter-spacing:-.03em}.section-title a{min-height:34px;padding:0 11px;background:var(--bg)}.feed-list{margin-top:16px}.feed-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;padding:16px 2px;border-top:1px solid var(--border)}.feed-row h3{min-width:0;margin:0;font-size:15px;font-weight:600;line-height:1.5}.feed-row:hover h3{color:var(--blue)}.row-arrow{color:#b0b8c1;font-size:18px}.feed-row:hover .row-arrow{color:var(--blue)}.empty-state{margin:0;padding:40px 0;color:var(--muted);font-size:14px;text-align:center}
.listing-shell{padding:30px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}.listing-head{padding-bottom:25px;border-bottom:1px solid var(--border)}.listing-head h1{margin:0;font-size:32px;font-weight:800;line-height:1.25;letter-spacing:-.045em}.board-row{display:grid;grid-template-columns:minmax(0,1fr) 32px;gap:20px;align-items:center;padding:23px 8px;border-bottom:1px solid var(--border);transition:.15s ease}.board-row:hover{margin-inline:-10px;padding-inline:18px;border-color:transparent;border-radius:12px;background:#f8fafc}.board-row h2{margin:0;font-size:18px;font-weight:700;line-height:1.45}.board-row:hover h2{color:var(--blue)}.board-row p{max-width:720px;margin:7px 0 0;color:var(--muted);font-size:14px}.pagination{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;padding-top:26px;color:var(--muted);font-size:13px}.pagination div{display:flex;gap:8px}.pagination a{padding:7px 11px;border-radius:8px;background:var(--blue-soft);color:var(--blue);font-weight:600}
.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding-top:26px}.product-card{min-width:0;overflow:hidden;border:1px solid var(--border);border-radius:14px;background:#fff;transition:.18s ease}.product-card:hover{border-color:#b8d5ff;box-shadow:0 10px 26px rgba(2,32,71,.08);transform:translateY(-3px)}.product-card>a:first-child{display:block;overflow:hidden;background:var(--bg)}.product-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.product-placeholder{display:grid!important;aspect-ratio:4/3;place-items:center;background:linear-gradient(135deg,#f3f6f9,#e8f3ff)!important}.product-placeholder span{color:var(--blue);font-size:46px;font-weight:800}.product-card h2{margin:18px 18px 0;font-size:17px;font-weight:700}.product-card>p{margin:7px 18px 18px;color:var(--muted);font-size:13px}.product-card .price,.price{color:var(--blue);font-weight:700}
.detail{max-width:840px;margin-inline:auto;padding:34px clamp(24px,5vw,56px);border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}.theme-breadcrumb{max-width:1180px;margin:0 auto 18px;color:var(--muted);font-size:13px}.theme-breadcrumb ol{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}.theme-breadcrumb li{display:flex;gap:8px}.theme-breadcrumb a:hover{color:var(--blue)}.detail-header{padding-bottom:28px;border-bottom:1px solid var(--border)}.detail-header h1{margin:0;font-size:clamp(34px,5vw,52px);font-weight:800;line-height:1.22;letter-spacing:-.05em}.detail-header p{max-width:680px;margin:18px 0 0;color:var(--muted);font-size:17px}.article-detail .detail-header:before{display:inline-flex;margin-bottom:16px;padding:5px 9px;border-radius:999px;background:var(--blue-soft);color:var(--blue);content:"文章";font-size:12px;font-weight:700}.content-body{padding:26px 0 8px;font-size:16px;line-height:1.85;overflow-wrap:anywhere}.content-body p{margin-block:1.45em}.content-body h2{margin:2.2em 0 .7em;font-size:27px;font-weight:750}.content-body h3{margin:2em 0 .65em;font-size:21px;font-weight:700}.content-body a{color:var(--blue);text-decoration:underline;text-underline-offset:4px}.content-body img{display:block;max-width:100%;height:auto;margin:36px auto;border-radius:12px}.content-body ul,.content-body ol{margin-block:1.5em;padding-left:1.5em}.content-body ul{list-style:disc}.content-body ol{list-style:decimal}.content-body blockquote{margin:32px 0;padding:18px 22px;border-left:4px solid var(--blue);border-radius:0 10px 10px 0;background:var(--blue-soft);color:#4e5968}.content-body pre{overflow-x:auto;margin-block:28px;padding:20px 22px;border-radius:12px;background:#191f28;color:#e8edf3;font:14px/1.75 var(--mono)}.content-body code{font-family:var(--mono)}.content-body table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;font-size:14px}.content-body td,.content-body th{padding:11px 14px;border:1px solid var(--border)}.related-posts{margin-top:48px;padding-top:24px;border-top:1px solid var(--border)}
.product-detail{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(36px,6vw,72px);padding:34px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}.product-detail>img{width:100%;aspect-ratio:4/3;border-radius:14px;background:var(--bg);object-fit:cover}.product-detail .detail-header{padding-bottom:22px}.product-detail .detail-header h1{font-size:clamp(32px,4vw,46px)}.product-detail .content-body{padding-top:15px}.sku-list{display:grid;margin-top:22px;border-top:1px solid var(--border)}.sku-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 18px;padding:14px 0;border-bottom:1px solid var(--border);font-size:13px}.product-detail form{display:flex;gap:12px;margin-top:24px;padding-top:24px;border-top:1px solid var(--border)}.product-detail form label{flex:1;font-size:0}.product-detail form input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--text);font:14px var(--sans)}.product-detail form input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft);outline:0}.product-detail form button{min-height:44px;padding:0 17px;border:0;border-radius:10px;background:var(--blue);color:#fff;font:600 14px var(--sans);cursor:pointer}.product-detail form button:hover{background:var(--blue-hover)}
.site-footer{border-top:1px solid var(--border);background:#fff}.footer-inner{display:flex;justify-content:space-between;gap:48px;padding-block:38px 44px;color:var(--muted);font-size:13px}.footer-inner strong{color:var(--text);font-size:17px;font-weight:800}.footer-inner p{margin:6px 0 0}.footer-navigation .primary-menu{justify-content:flex-end;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px}.footer-navigation .primary-menu a{padding:0;font-size:13px;font-weight:500}.footer-navigation .primary-menu a:hover{background:transparent;color:var(--blue)}.footer-navigation .primary-menu li>ul{top:100%;right:0;left:auto}.footer-sns{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px 18px;margin-top:10px}.footer-sns a:hover{color:var(--blue)}
@media(max-width:900px){.site-width{width:min(100% - 32px,1180px)}.menu-toggle{display:inline-flex}.header-nav{position:absolute;top:60px;right:16px;left:16px;display:none;padding:10px;border:1px solid var(--border);border-radius:14px;background:#fff;box-shadow:0 12px 32px rgba(2,32,71,.12)}.nav-toggle:checked~.header-nav{display:block}.header-nav .primary-menu{display:block}.header-nav .primary-menu a{padding:11px 12px}.header-nav .primary-menu li>ul{position:static;display:block;margin-left:14px;padding:0;border:0;box-shadow:none}.home-sections{grid-template-columns:1fr}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-detail{grid-template-columns:1fr}}
@media(max-width:620px){.site-main{padding-block:22px 56px}.hero{padding:34px 24px;border-radius:18px}.hero h1{font-size:38px}.hero-description{font-size:16px}.home-section,.listing-shell{padding:21px}.board-row{grid-template-columns:minmax(0,1fr) 18px;gap:9px;padding:19px 0}.board-row:hover{margin:0;padding:19px 8px}.board-row h2{font-size:16px}.product-grid{grid-template-columns:1fr}.detail{padding:26px 21px}.detail-header h1{font-size:34px}.content-body{font-size:15px}.product-detail{padding:21px}.product-detail form{flex-direction:column}.footer-inner{flex-direction:column}.footer-navigation .primary-menu,.footer-sns{justify-content:flex-start}}
.detail{max-width:none}
.content-field{padding:24px 0;border-bottom:1px solid var(--border)}.content-field:last-child{border-bottom:0}.content-field-label{margin:0 0 14px;font-size:18px;font-weight:700}.content-field-rich .content-field-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.content-field-image img{display:block;width:100%;max-height:640px;border-radius:14px;object-fit:cover}.content-field-image figcaption{margin-top:8px;color:var(--muted);font-size:13px}.content-field-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.content-field-gallery img{width:100%;aspect-ratio:4/3;border-radius:12px;object-fit:cover}.content-field-file,.content-field-files a{color:var(--blue);text-decoration:underline;text-underline-offset:4px}.content-field-files{margin:0;padding-left:20px}.content-field-value{display:grid;grid-template-columns:minmax(120px,220px) minmax(0,1fr);gap:20px}.content-field-value dt{font-weight:700}.content-field-value dd{margin:0;color:var(--muted)}.content-field pre{overflow-x:auto;padding:18px;border-radius:12px;background:var(--bg);font:13px/1.7 var(--mono)}
@media(max-width:620px){.content-field-gallery{grid-template-columns:1fr 1fr}.content-field-value{grid-template-columns:1fr;gap:5px}}
.content-field-rich .markdown-body{padding:26px 0 8px;background:transparent;color:var(--text);font-family:var(--sans);line-height:1.75}.content-field-rich .markdown-body a{color:var(--blue)}.content-field-rich .markdown-body pre{background:#191f28;color:#e8edf3}.content-field-rich .markdown-body img{border-radius:12px}
.product-page{overflow:hidden;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}.product-showcase{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(32px,5vw,64px);padding:clamp(24px,4vw,48px)}.product-media{min-width:0}.product-main-image{margin:0}.product-main-image img,.product-main-placeholder{display:block;width:100%;aspect-ratio:4/3;border-radius:16px;background:var(--bg);object-fit:cover}.product-main-placeholder{display:grid;place-items:center;background:linear-gradient(135deg,#f3f6f9,#e8f3ff)}.product-main-placeholder span{color:var(--blue);font-size:64px;font-weight:800}.product-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px}.product-gallery img{width:100%;aspect-ratio:1;border:1px solid var(--border);border-radius:10px;object-fit:cover}.product-summary{min-width:0}.product-summary .detail-header{padding-bottom:26px}.product-summary .detail-header h1{font-size:clamp(32px,4vw,48px)}.product-skus{padding-top:24px}.product-skus h2{margin:0;font-size:18px}.product-skus .sku-list{margin-top:14px}.product-order{margin-top:24px}.product-introduction{padding:8px clamp(24px,4vw,48px) 32px;border-top:1px solid var(--border)}.product-introduction .content-field-rich .content-field-label{position:static;width:auto;height:auto;margin:0 0 18px;overflow:visible;clip-path:none;font-size:24px}.product-introduction .content-field-rich .content-field-label:after{content:"介绍";font-size:0}.product-introduction .content-field-rich .markdown-body{padding-top:0}
@media(max-width:800px){.product-showcase{grid-template-columns:1fr}.product-gallery{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:480px){.product-gallery{grid-template-columns:repeat(3,minmax(0,1fr))}}
.product-gallery button{cursor:pointer;border:2px solid transparent;border-radius:12px;background:transparent;padding:0;transition:border-color .15s ease,transform .15s ease}.product-gallery button:hover{transform:translateY(-2px)}.product-gallery button[aria-pressed="true"]{border-color:var(--blue)}.product-gallery button:focus-visible{outline:3px solid rgba(49,130,246,.24);outline-offset:2px}.product-gallery button img{display:block}.product-main-image img[hidden]{display:none}
.footer-sns{gap:14px}.footer-sns a{display:inline-flex;align-items:center;justify-content:center;min-width:24px;min-height:24px;font-size:21px;transition:color .15s ease}.footer-sns a:focus-visible{border-radius:4px}.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(prefers-reduced-motion:reduce){.theme-site *{transition-duration:.01ms!important}}
</style>
