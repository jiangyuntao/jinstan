<div class="overflow-x-auto{if !$embedded} rounded-xl border border-slate-200 bg-white shadow-sm{/if}">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold text-slate-500">
            <tr>
                {foreach $columns as $column}<th class="whitespace-nowrap px-5 py-3{if $column['view'] === 'actions.jst'} text-center{/if}">{$column['label']}</th>{/foreach}
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
            {foreach $rows as $row}
                <tr class="hover:bg-slate-50">
                    {foreach $columns as $column}
                        <td class="align-middle px-5 py-4{if $column['view'] === 'actions.jst'} text-center{/if}">{include $column['view'], field: $column, row: $row}</td>
                    {/foreach}
                </tr>
            {else}
                <tr><td class="px-5 py-10 text-center text-slate-500" colspan="{count($columns)}">{$empty}</td></tr>
            {/foreach}
        </tbody>
    </table>
</div>
