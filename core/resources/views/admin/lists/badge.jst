{var $value = (string) ($row[$field['name']] ?? '')}
{var $label = ['published' => t('已发布'), 'draft' => t('草稿'), 'enabled' => t('已启用'), 'disabled' => t('已停用')][$value] ?? $value}
<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium{if $value === 'published' || $value === 'enabled'} bg-emerald-50 text-emerald-700{elseif $value === 'draft' || $value === 'disabled'} bg-slate-100 text-slate-600{else} bg-blue-50 text-blue-700{/if}">{$label}</span>
