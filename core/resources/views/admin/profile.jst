{extends 'layout.jst'}{block content}<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">{ifset $error}{if $error !== null}<div class="mb-6 rounded-lg bg-red-50 p-4 text-red-700" role="alert">{$error}</div>{/if}{/ifset}<form class="space-y-6" method="post" action="{route('admin.profile.update')}"><input type="hidden" name="_token" value="{$csrfToken}"><label class="block font-medium">{=t('邮箱')}<input class="mt-2 block w-full" name="email" type="email" value="{$user['email']}" required></label><label class="block font-medium">{=t('新密码（留空则不修改）')}<input class="mt-2 block w-full" name="password" type="password" minlength="6" maxlength="1024" autocomplete="new-password"></label>{include 'partials/form-actions.jst', submitLabel: t('保存资料'), cancelUrl: null}</form></section>{/block}
