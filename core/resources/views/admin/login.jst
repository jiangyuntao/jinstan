<!doctype html>
<html lang="{$adminLocale}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{=t('登录 · Jinstan')}</title>
    <link rel="stylesheet" href="{=coreAsset('admin.css')}">
    <style n:syntax="off">
        body { background: #f2f4f6; color: #191f28; font-family: Pretendard, Inter, ui-sans-serif, system-ui, sans-serif; }
        main { box-shadow: 0 12px 32px rgba(2, 32, 71, .08) !important; }
        input { border-color: #e5e8eb !important; }
        input:focus { border-color: #3182f6 !important; box-shadow: 0 0 0 3px #e8f3ff; outline: none; }
        button { background: #3182f6 !important; }
        button:hover { background: #2272eb !important; }
    </style>
</head>
<body class="grid min-h-screen place-items-center p-5">
    <main class="w-full max-w-md rounded-2xl bg-white p-8">
        <p class="text-sm font-medium text-[#3182f6]">{=t('admin.brand')}</p>
        <h1 class="mt-2 text-2xl font-bold">{=t('管理员登录')}</h1>
        <p class="mt-2 text-sm text-slate-500">{=t('登录后进入站点管理后台。')}</p>
        <form class="mt-7 space-y-4" method="post" action="{route('login.store')}">
            <input type="hidden" name="_token" value="{$csrfToken}">
            <label class="block text-sm font-medium">{=t('邮箱')} <input class="mt-1.5 block w-full rounded-lg border px-3 py-2.5" name="email" type="email" required></label>
            <label class="block text-sm font-medium">{=t('密码')} <input class="mt-1.5 block w-full rounded-lg border px-3 py-2.5" name="password" type="password" maxlength="1024" autocomplete="current-password" required></label>
            <button class="w-full rounded-lg px-4 py-2.5 font-medium text-white" type="submit">{=t('登录')}</button>
        </form>
    </main>
</body>
</html>
