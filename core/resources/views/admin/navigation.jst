{extends 'layout.jst'}

{block content}
<section class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
    <aside class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold">{=t('导航菜单')}</h2>
        <nav class="mt-3 space-y-1">{foreach $menus as $menu}<a class="block rounded-lg px-3 py-2 text-sm{if $menu['handle'] === $selectedMenu} bg-blue-50 font-medium text-blue-700{else} hover:bg-slate-100{/if}" href="{route('admin.navigation.index', ['menu' => $menu['handle'], 'locale' => $locale])}">{$menu['name']}</a>{else}<p class="text-sm text-slate-500">{=t('还没有导航菜单。')}</p>{/foreach}</nav>
        <form class="mt-5 space-y-3 border-t border-slate-100 pt-5" method="post" action="{route('admin.navigation.store')}"><input name="_token" type="hidden" value="{$csrfToken}"><label class="block text-sm font-medium">{=t('菜单名称')}<input class="mt-1 block w-full" name="name" required></label><label class="block text-sm font-medium">{=t('标识')}<input class="mt-1 block w-full" name="handle" pattern="[a-z0-9]+(-[a-z0-9]+)*" required></label><button class="admin-button px-3 py-2 text-sm" type="submit">{=t('新建菜单')}</button></form>
    </aside>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    {if $selectedMenu === ''}<p class="p-6 text-sm text-slate-500">{=t('先在左侧创建一个菜单。')}</p>{else}
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 px-5 py-4"><form class="flex items-center gap-3" method="get"><input type="hidden" name="menu" value="{$selectedMenu}"><label class="text-sm font-medium" for="navigation-locale">{=t('内容语言')}</label><select id="navigation-locale" name="locale" onchange="this.form.submit()">{foreach $locales as $code => $label}<option value="{$code}" selected="{$code === $locale}">{$label} ({$code})</option>{/foreach}</select></form><a class="admin-button inline-flex items-center gap-2 px-4 py-2.5" href="{route('admin.navigation-items.create', ['menu' => $selectedMenu, 'locale' => $locale])}"><i class="ti ti-plus" aria-hidden="true"></i>{=t('新增菜单项')}</a></div>
        <div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs font-semibold text-slate-500"><tr><th class="px-5 py-3">{=t('名称')}</th><th class="px-5 py-3">{=t('链接')}</th><th class="px-5 py-3">{=t('打开方式')}</th><th class="px-5 py-3">{=t('排序')}</th><th class="px-5 py-3 text-center">{=t('操作')}</th></tr></thead><tbody class="divide-y divide-slate-100">
        {foreach $items as $item}<tr><td class="px-5 py-4"><a class="font-medium text-blue-700" href="{route('admin.navigation-items.edit', ['id' => $item['id'], 'menu' => $selectedMenu, 'locale' => $locale])}">{$item['label']}</a>{if !$item['translated']}<span class="ml-2 rounded-full bg-amber-50 px-2 py-1 text-xs text-amber-700">{=t('未翻译 · 原文')} {$item['sourceLocale']}</span>{/if}</td><td class="px-5 py-4 text-slate-500">{$item['url']}</td><td class="px-5 py-4">{$item['target']}</td><td class="px-5 py-4">{$item['position']}</td><td class="px-5 py-4"><div class="flex items-center justify-center gap-3 whitespace-nowrap"><a class="inline-flex items-center gap-1 font-medium text-blue-700 hover:text-blue-900" href="{route('admin.navigation-items.edit', ['id' => $item['id'], 'menu' => $selectedMenu, 'locale' => $locale])}"><i class="ti ti-pencil" aria-hidden="true"></i>{=t('编辑')}</a><form method="post" action="{route('admin.navigation-items.delete', ['id' => $item['id']])}" data-confirm-title="{=t('删除菜单项？')}" data-confirm-message="{=t('此菜单项将从前台导航中移除，无法撤销。')}" data-confirm-action="{=t('删除菜单项')}"><input type="hidden" name="_token" value="{$csrfToken}"><input type="hidden" name="menu" value="{$selectedMenu}"><input type="hidden" name="locale" value="{$locale}"><button class="inline-flex items-center gap-1 font-medium text-red-600 hover:text-red-800" type="submit"><i class="ti ti-trash" aria-hidden="true"></i>{=t('删除')}</button></form></div></td></tr>{else}<tr><td class="px-5 py-10 text-center text-slate-500" colspan="5">{=t('此菜单暂未添加项目。')}</td></tr>{/foreach}
        </tbody></table></div>
    {/if}
    </div>
</section>
{/block}
