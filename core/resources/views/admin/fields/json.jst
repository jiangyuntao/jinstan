<div>
    <label class="block text-sm font-semibold text-slate-800" for="field-{$field['name']}">{$field['label']}{if $field['required']}<span class="ml-1 text-red-500" aria-hidden="true">*</span>{/if}</label>
    <textarea class="mt-2 block w-full border bg-white px-3 py-2.5 font-mono text-sm text-slate-900" id="field-{$field['name']}" name="{$field['inputName']}" rows="{$field['rows']}" spellcheck="false"{if $field['required']} required{/if}>{$field['value'] ?? ''}</textarea>
    <p class="mt-2 text-xs text-slate-500">{=t('仅接受 JSON 对象或数组，保存时会转换为结构化数据。')}</p>
    {ifset $field['help']}<p class="mt-2 text-xs text-slate-500">{$field['help']}</p>{/ifset}
</div>
