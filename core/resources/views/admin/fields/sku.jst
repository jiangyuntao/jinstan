<div x-data="skuRows(JSON.parse(document.getElementById('sku-rows-{$field['name']}').textContent))">
    <div class="flex items-center justify-between gap-4">
        <label class="block text-sm font-semibold text-slate-800">{$field['label']}{if $field['required']}<span class="ml-1 text-red-500" aria-hidden="true">*</span>{/if}</label>
        <button class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" type="button" @click="add()">{=t('fields.sku_add')}</button>
    </div>
    <script id="sku-rows-{$field['name']}" type="application/json">{$field['rowsJson']|noescape}</script>
    <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="min-w-[760px]">
            <div class="grid gap-3 text-xs font-semibold text-slate-700" style="grid-template-columns: minmax(12rem, 1.4fr) minmax(11rem, 1fr) 8rem 9rem 4.5rem; margin-bottom: 0.5rem;">
                <span class="block text-left">{=t('fields.sku_title')}</span>
                <span class="block text-left">{=t('fields.sku_code')}</span>
                <span class="block text-left">{=t('fields.sku_stock')}</span>
                <span class="block text-left">{=t('fields.sku_price')}</span>
                <span class="block text-left"></span>
            </div>
            <template x-for="(row, index) in rows" :key="row.key">
                <div class="grid items-center gap-3" style="grid-template-columns: minmax(12rem, 1.4fr) minmax(11rem, 1fr) 8rem 9rem 4.5rem; margin-bottom: 0.75rem;">
                    <input class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" :name="'{$field['inputName']}[' + index + '][title]'" type="text" x-model="row.title" aria-label="{=t('fields.sku_title')}" required>
                    <input class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm uppercase" :name="'{$field['inputName']}[' + index + '][code]'" type="text" x-model="row.code" maxlength="100" pattern="{$field['pattern']}" autocapitalize="characters" spellcheck="false" placeholder="{$field['placeholder']}" aria-label="{=t('fields.sku_code')}" required>
                    <input class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" :name="'{$field['inputName']}[' + index + '][stock]'" type="number" x-model="row.stock" min="0" step="1" aria-label="{=t('fields.sku_stock')}" required>
                    <input class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" :name="'{$field['inputName']}[' + index + '][price]'" type="number" x-model="row.price" min="0" step="0.01" aria-label="{=t('fields.sku_price')}" required>
                    <button class="rounded-lg px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 disabled:text-slate-300" type="button" @click="remove(index)" :disabled="rows.length === 1">{=t('fields.sku_remove')}</button>
                </div>
            </template>
        </div>
    </div>
    <p class="mt-2 flex items-start gap-1.5 px-1 text-xs text-slate-500" style="line-height: 1.25rem;"><span class="mt-1.5 block shrink-0 rounded-full bg-slate-300" style="width: 0.25rem; height: 0.25rem;" aria-hidden="true"></span><span>{=t('fields.sku_help')}</span></p>
</div>
