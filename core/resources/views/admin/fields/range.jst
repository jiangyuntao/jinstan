<div x-data="{ value: '{$field['value'] ?? $field['min']}' }">
    <label class="block text-sm font-semibold text-slate-800" for="field-{$field['name']}">{$field['label']}{if $field['required']}<span class="ml-1 text-red-500" aria-hidden="true">*</span>{/if}</label>
    <div class="mt-3 flex items-center gap-4"><input class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-blue-600" id="field-{$field['name']}" name="{$field['inputName']}" type="range" min="{$field['min']}" max="{$field['max']}" step="{$field['step']}" value="{$field['value'] ?? $field['min']}" x-model="value"{if $field['required']} required{/if}><output class="min-w-10 rounded-md bg-blue-50 px-2 py-1 text-center text-sm font-medium text-blue-700" x-text="value"></output></div>
    {ifset $field['help']}<p class="mt-2 text-xs text-slate-500">{$field['help']}</p>{/ifset}
</div>
