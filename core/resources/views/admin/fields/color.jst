<div>
    <label class="block text-sm font-semibold text-slate-800" for="field-{$field['name']}">{$field['label']}{if $field['required']}<span class="ml-1 text-red-500" aria-hidden="true">*</span>{/if}</label>
    <div class="mt-2 flex items-center gap-3"><input class="h-11 w-14 cursor-pointer border bg-white p-1" id="field-{$field['name']}" name="{$field['inputName']}" type="color" value="{$field['value'] ?: '#3182f6'}"{if $field['required']} required{/if}><span class="text-sm text-slate-500">{$field['value'] ?: '#3182f6'}</span></div>
    {ifset $field['help']}<p class="mt-2 text-xs text-slate-500">{$field['help']}</p>{/ifset}
</div>
