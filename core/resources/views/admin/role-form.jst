{extends 'layout.jst'}

{block content}
<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    {if $error !== null}<div class="mb-6 rounded-lg bg-red-50 p-4 text-red-700" role="alert">{$error}</div>{/if}
    <form class="space-y-6" method="post">
        <input type="hidden" name="_token" value="{$csrfToken}">
        <div><label class="block font-medium" for="role-label">{=t('角色名称')}</label><input class="mt-2 block w-full" id="role-label" name="label" value="{$role['label']}" maxlength="100" required></div>
        <div><label class="block font-medium" for="role-key">{=t('角色标识')}</label><input class="mt-2 block w-full font-mono" id="role-key" name="role_key" value="{$role['role_key']}" pattern="[a-z][a-z0-9._-]+" maxlength="100" required{if $role['role_key'] !== ''} readonly{/if}><p class="mt-2 text-sm text-slate-500">{=t('创建后不可修改，仅允许小写字母、数字、点、横线和下划线。')}</p></div>
        <fieldset><legend class="font-medium">{=t('权限')}</legend><p class="mt-1 text-sm text-slate-500">{if $role['role_key'] === 'administrator'}{=t('内置管理员始终拥有全部权限。')}{else}{=t('权限由 Core 与 Plugin 注册，此处只负责分配。')}{/if}</p><div class="mt-3 grid gap-3 sm:grid-cols-2">{foreach $permissions as $permission}<label class="admin-choice admin-choice--block"><input name="permissions[]" type="checkbox" value="{$permission['permission_key']}"{if $role['role_key'] === 'administrator' || in_array($permission['permission_key'], $role['permissions'], true)} checked{/if}{if $role['role_key'] === 'administrator'} disabled{/if}><span><strong>{$permission['label']}</strong><span class="ml-1 font-mono text-xs text-slate-500">{$permission['permission_key']}</span></span></label>{/foreach}</div></fieldset>
        {include 'partials/form-actions.jst', submitLabel: t('保存'), cancelUrl: route('admin.roles.index')}
    </form>
</section>
{/block}
