{extends 'layout.jst'}

{block headerActions}
    <a class="admin-button inline-flex items-center gap-2 px-4 py-2.5" href="{route('admin.languages.create')}"><i class="ti ti-plus" aria-hidden="true"></i>{=t('新增语言')}</a>
{/block}

{block content}
<p class="text-sm text-slate-500">{=t('管理前台可用语言、后台内容编辑语言以及文字阅读方向。')}</p>
<section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto"><table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-slate-500"><tr><th class="px-5 py-3">{=t('语言代码')}</th><th class="px-5 py-3">{=t('显示名称')}</th><th class="px-5 py-3">{=t('文字方向')}</th><th class="px-5 py-3 text-center">{=t('操作')}</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
        {foreach $profiles as $code => $profile}
            {var $required = $code === $defaultLocale || $code === 'zh-CN'}
            <tr><td class="px-5 py-4 font-mono">{$code}{if $code === $defaultLocale}<span class="ml-2 rounded-full bg-blue-50 px-2 py-1 text-xs text-blue-700">{=t('默认')}</span>{/if}</td><td class="px-5 py-4">{$profile['name']}</td><td class="px-5 py-4">{=$profile['direction'] === 'rtl' ? t('RTL · 从右到左') : t('LTR · 从左到右')}</td><td class="px-5 py-4"><div class="flex items-center justify-center gap-3 whitespace-nowrap"><a class="inline-flex items-center gap-1 font-medium text-blue-700 hover:text-blue-900" href="{route('admin.languages.edit', ['code' => $code])}"><i class="ti ti-pencil" aria-hidden="true"></i>{=t('编辑')}</a>{if !$required}<form method="post" action="{route('admin.languages.delete', ['code' => $code])}" data-confirm-title="{=t('删除语言？')}" data-confirm-message="{=t('该语言将从前台和内容编辑器中移除，已有翻译数据会保留。')}" data-confirm-action="{=t('删除语言')}"><input type="hidden" name="_token" value="{$csrfToken}"><button class="inline-flex items-center gap-1 font-medium text-red-600 hover:text-red-800" type="submit"><i class="ti ti-trash" aria-hidden="true"></i>{=t('删除')}</button></form>{/if}</div></td></tr>
        {else}<tr><td class="px-5 py-10 text-center text-slate-500" colspan="4">{=t('暂无语言。')}</td></tr>{/foreach}
        </tbody>
    </table></div>
</section>
{/block}
