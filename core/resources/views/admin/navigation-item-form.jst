{extends 'layout.jst'}
{block content}
<nav class="mb-4 text-sm"><a class="text-blue-700" href="{route('admin.navigation.index', ['menu' => $menu, 'locale' => $locale])}">{=t('导航菜单')}</a> / {=$editing ? t('编辑菜单项') : t('新增菜单项')}</nav>
<form class="mb-5 flex items-center gap-3" method="get"><input type="hidden" name="menu" value="{$menu}"><label class="text-sm font-medium" for="item-locale">{=t('内容语言')}</label><select id="item-locale" name="locale" onchange="this.form.submit()">{foreach $locales as $code => $label}<option value="{$code}" selected="{$code === $locale}">{$label} ({$code})</option>{/foreach}</select></form>
{if $sourceReference}<aside class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-5"><div class="flex justify-between"><h2 class="font-semibold">{=t('原文参考')}</h2><span>{$sourceReference['locale']}</span></div><dl class="mt-3 grid gap-3 md:grid-cols-2"><div><dt class="text-xs text-amber-800">{=t('名称')}</dt><dd>{$sourceReference['label']}</dd></div><div><dt class="text-xs text-amber-800">{=t('链接')}</dt><dd>{$sourceReference['url']}</dd></div></dl></aside>{/if}
<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><form class="space-y-6" method="post" action="{$editing ? route('admin.navigation-items.update', ['id' => $item['id']]) : route('admin.navigation-items.store')}"><input type="hidden" name="_token" value="{$csrfToken}"><input type="hidden" name="menu" value="{$menu}"><input type="hidden" name="locale" value="{$locale}"><div><label class="block font-medium">{=t('名称')}<input class="mt-2 block w-full" name="label" value="{$item['label']}" required></label></div><div><label class="block font-medium">{=t('链接')}<input class="mt-2 block w-full" name="url" value="{$item['url']}" required></label></div><div><label class="block font-medium">{=t('上级菜单项')}<select class="mt-2 block w-full" name="parent_id"><option value="">{=t('无（顶级菜单）')}</option>{foreach $parentItems as $parent}<option value="{$parent['id']}" selected="{(int) ($item['parent_id'] ?? 0) === (int) $parent['id']}">{$parent['label']}</option>{/foreach}</select></label><p class="mt-2 text-xs text-slate-500">{=t('选择后，此菜单项将显示为对应项目的子菜单。')}</p></div><div class="grid gap-6 md:grid-cols-2"><label class="block font-medium">{=t('打开方式')}<select class="mt-2 block w-full" name="target"><option value="_self" selected="{$item['target'] === '_self'}">{=t('当前窗口')}</option><option value="_blank" selected="{$item['target'] === '_blank'}">{=t('新窗口')}</option></select></label><label class="block font-medium">{=t('排序')}<input class="mt-2 block w-full" type="number" min="0" name="position" value="{$item['position']}"></label></div>{include 'partials/form-actions.jst', submitLabel: t('保存'), cancelUrl: route('admin.navigation.index', ['menu' => $menu, 'locale' => $locale])}</form></section>
{/block}
