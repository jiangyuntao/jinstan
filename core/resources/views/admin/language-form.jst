{extends 'layout.jst'}

{block content}
<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-language-catalog="{$catalogJson}" x-data="languageProfile(JSON.parse($el.dataset.languageCatalog))" @change="applyLanguage($event)">
    <form class="space-y-6" method="post">
        <input type="hidden" name="_token" value="{$csrfToken}">
        {if $editing}
            <div><label class="block font-medium">{=t('语言代码')}</label><p class="mt-2 font-mono text-slate-700">{$code}</p></div>
        {else}
            {include 'fields/searchable-select.jst', field: ['name' => 'language-code', 'inputName' => 'code', 'label' => t('语言'), 'value' => '', 'options' => $availableOptions, 'required' => true, 'help' => t('可按语言名称或国际标准语言代码搜索。')]}
        {/if}
        <div><label class="block font-medium" for="language-name">{=t('显示名称')}</label><input class="mt-2 block w-full" id="language-name" name="name" value="{$values['name']}" maxlength="80" required></div>
        <div><label class="block font-medium" for="language-direction">{=t('文字方向')}</label><select class="mt-2 block w-full" id="language-direction" name="direction"><option value="ltr" selected="{$values['direction'] === 'ltr'}">LTR · {=t('从左到右')}</option><option value="rtl" selected="{$values['direction'] === 'rtl'}">RTL · {=t('从右到左')}</option></select></div>
        {include 'partials/form-actions.jst', submitLabel: t('保存'), cancelUrl: route('admin.languages.index')}
    </form>
</section>
{/block}

{block scripts}
<script n:syntax="off">
document.addEventListener('alpine:init', () => {
    Alpine.data('languageProfile', (catalog) => ({
        applyLanguage(event) {
            if (event.target.name !== 'code' || !catalog[event.target.value]) return;
            document.getElementById('language-name').value = catalog[event.target.value].name;
            document.getElementById('language-direction').value = catalog[event.target.value].direction;
        },
    }));
});
</script>
{/block}
