{extends 'layout.jst'}
{block headerActions}<a class="admin-button inline-flex items-center gap-2 px-4 py-2.5" href="{route('admin.taxonomies.create')}"><i class="ti ti-plus" aria-hidden="true"></i>{=t('新建词汇表')}</a>{/block}
{block content}
<p class="text-sm text-slate-500">{=t('使用词汇表整理分类、标签或品牌。进入词汇表管理其中的条目。')}</p>
<section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs font-semibold text-slate-500"><tr><th class="px-5 py-3">{=t('词汇表名称')}</th><th class="px-5 py-3">{=t('固定标识')}</th><th class="px-5 py-3">{=t('条目数量')}</th><th class="px-5 py-3 text-center">{=t('操作')}</th></tr></thead><tbody class="divide-y divide-slate-100 text-slate-700">
{foreach $taxonomies as $group}<tr class="hover:bg-slate-50"><td class="px-5 py-4 font-medium"><a class="text-blue-700" href="{route('admin.taxonomies.index', ['taxonomy' => $group['handle']])}">{$group['label']}</a></td><td class="px-5 py-4 font-mono text-slate-500">{$group['handle']}</td><td class="px-5 py-4">{$group['term_count']}</td><td class="px-5 py-4"><div class="flex items-center justify-center gap-3 whitespace-nowrap"><a class="font-medium text-blue-700" href="{route('admin.taxonomies.index', ['taxonomy' => $group['handle']])}">{=t('管理条目')}</a><a class="font-medium text-blue-700" href="{route('admin.taxonomies.edit', ['handle' => $group['handle']])}">{=t('编辑')}</a><a class="font-medium text-red-600" href="{route('admin.taxonomies.delete.confirm', ['handle' => $group['handle']])}">{=t('删除')}</a></div></td></tr>
{else}<tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">{=t('还没有词汇表，先创建“品牌”或“标签”。')}</td></tr>{/foreach}
</tbody></table></div></section>
{/block}
