{extends 'layout.jst'}

{block content}
<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    {if $error !== null}<div class="mb-6 rounded-lg bg-red-50 p-4 text-red-700" role="alert">{$error}</div>{/if}
    <form class="space-y-6" method="post">
        <input type="hidden" name="_token" value="{$csrfToken}">
        <div>
            <label class="block font-medium" for="user-email">{=t('邮箱')}</label>
            <input class="mt-2 block w-full" id="user-email" name="email" type="email" value="{$user['email']}" maxlength="190" autocomplete="email" required>
        </div>
        <div>
            <label class="block font-medium" for="user-password">{=$user['id'] === null ? t('密码') : t('新密码（留空则不修改）')}</label>
            <input class="mt-2 block w-full" id="user-password" name="password" type="password" minlength="6" maxlength="1024" autocomplete="new-password"{if $user['id'] === null} required{/if} aria-describedby="user-password-help">
            <p class="mt-2 text-sm text-slate-500" id="user-password-help">{=t('密码至少需要 6 个字符。')}</p>
        </div>
        <fieldset>
            <legend class="font-medium">{=t('角色')}</legend>
            <p class="mt-1 text-sm text-slate-500">{=t('用户可以同时拥有多个角色，实际权限为这些角色权限的合集。')}</p>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {foreach $roles as $role}
                    <label class="admin-choice admin-choice--block"><input name="roles[]" type="checkbox" value="{$role['role_key']}"{if in_array($role['role_key'], $user['roles'] ?? [], true)} checked{/if}><span><strong>{$role['label']}</strong><span class="ml-1 font-mono text-xs text-slate-500">{$role['role_key']}</span></span></label>
                {/foreach}
            </div>
        </fieldset>
        {include 'partials/form-actions.jst', submitLabel: t('保存'), cancelUrl: route('admin.users.index')}
    </form>
</section>
{/block}
