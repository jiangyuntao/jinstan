<script type="application/json" id="taxonomy-config-{$group['handle']}">{$group['config']|noescape}</script>
<fieldset class="space-y-3" x-data="taxonomyPicker(JSON.parse(document.getElementById($el.dataset.config).textContent))" data-config="taxonomy-config-{$group['handle']}">
    <legend class="font-semibold">{$group['label']}{if $group['required']}<span class="ml-1 text-red-500" aria-hidden="true">*</span>{/if}</legend>
    <input type="hidden" name="terms[{$group['handle']}][]" value="">
    <div class="relative" @click.outside="open = false">
        <div class="field-select field-select-trigger flex min-h-11 w-full items-center justify-between gap-2 text-left" role="combobox" tabindex="0" :aria-expanded="open.toString()" aria-controls="taxonomy-options-{$group['handle']}" @click="toggle()" @keydown.enter.prevent="toggle()" @keydown.space.prevent="toggle()">
            <div class="min-w-0 flex-1">
                <span x-show="!selected.length" class="text-slate-500">{=t('taxonomy.select', ['name' => $group['label']])}</span>
                <template x-if="selected.length && !multiple">
                    <span class="block truncate text-slate-900" x-text="selected[0].name"></span>
                </template>
                <div class="flex flex-wrap" x-show="selected.length && multiple" style="gap: 0.375rem">
                    <template x-for="item in selected" :key="item.id">
                        <span class="inline-flex max-w-full items-center rounded-md bg-blue-50 text-sm text-blue-800" style="gap: 0.25rem; padding: 0.25rem 0.375rem 0.25rem 0.5rem">
                            <input type="hidden" name="terms[{$group['handle']}][]" :value="item.id">
                            <span class="truncate" x-text="item.name"></span>
                            <button class="inline-flex shrink-0 items-center justify-center rounded text-blue-700 hover:bg-blue-100" type="button" :aria-label="'{=t('移除')} ' + item.name" @click.stop="remove(item.id)" style="height: 1rem; width: 1rem; font-size: 0.75rem"><i class="ti ti-x" aria-hidden="true"></i></button>
                        </span>
                    </template>
                </div>
                <template x-for="item in selected" :key="'single-' + item.id">
                    <input x-show="!multiple" type="hidden" name="terms[{$group['handle']}][]" :value="item.id">
                </template>
            </div>
            <svg class="h-4 w-4 shrink-0 text-slate-500 transition" :class="open ? 'rotate-180' : ''" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
        </div>
        <div class="field-select-menu absolute z-20 mt-1 w-full border p-2" id="taxonomy-options-{$group['handle']}" x-show="open" x-cloak>
            <div class="relative">
                <i class="ti ti-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
                <input class="field-select block w-full bg-white py-2 pr-3 text-sm" id="taxonomy-search-{$group['handle']}" type="search" x-model="query" @input.debounce.250ms="search()" @keydown.enter.prevent="search()" autocomplete="off" placeholder="{=t('输入名称或 URL 别名')}" x-ref="search" style="padding-left: 2.5rem">
            </div>
            <p class="px-3 py-2 text-sm text-slate-500" role="status" x-text="message"></p>
            <div class="max-h-56 overflow-y-auto" role="listbox">
                <template x-for="item in items" :key="item.id">
                    <button class="field-select-option block w-full px-3 py-2 text-left text-sm" type="button" @click="choose(item)" x-text="item.name"></button>
                </template>
            </div>
        </div>
    </div>
</fieldset>
