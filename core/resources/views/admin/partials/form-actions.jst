<div class="flex items-center gap-4 border-t border-slate-200 pt-5">
    <button class="admin-button px-4 py-2.5" type="submit">{$submitLabel}</button>
    {ifset $cancelUrl}
        {if $cancelUrl !== null}
            <a class="text-slate-500 hover:text-slate-700" href="{$cancelUrl}">{ifset $cancelLabel}{$cancelLabel}{else}{=t('取消')}{/ifset}</a>
        {/if}
    {/ifset}
</div>
